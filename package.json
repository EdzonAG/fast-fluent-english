{
  "name": "fast-fluent-english",
  "version": "2.0.0",
  "private": true,
  "description": "SpectaCulTours + FAST fluent English: sitio estático con build mínimo",
  "type": "module",
  "scripts": {
    "imagenes": "node scripts/optimizar-imagenes.mjs",
    "logos": "node scripts/optimizar-logos.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/servir.mjs dist 3000",
    "start": "node scripts/servir.mjs dist ${PORT:-3000}",
    "cv": "node scripts/generar-cv.mjs",
    "test": "node scripts/build.mjs && node --test --test-reporter=spec tests/sitio.test.mjs"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "photoswipe": "^5.4.4",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0"
  }
}
